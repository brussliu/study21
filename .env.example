# =====================================================================
# Study 2.1 — environment template
# Copy this file to `.env` if a given tooling needs it. The dev scripts
# (scripts/*.ps1) read the values below with safe defaults, so a `.env`
# file is optional for local development.
#
# This file contains placeholders only. Never commit the real `.env`, tokens,
# passwords, or old-system credentials.
# =====================================================================

# ---- Frontend dev servers ----
PC_WEB_PORT=5173
MOBILE_WEB_PORT=5174

# ---- Backend ports ----
ADMIN_API_PORT=8081
USER_API_PORT=8082

# ---- API base URLs (consumed by the frontends) ----
ADMIN_API_BASE_URL=http://localhost:8081
USER_API_BASE_URL=http://localhost:8082

# ---- CORS allowed origins (comma-separated, never "*") ----
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Application environment (development | staging | production) ----
APP_ENV=development

# ---- Docker Compose / database ----
# The password has no fallback by design: docker compose fails fast when it is
# absent. Replace the placeholder only in your untracked `.env` file.
# NAS ではホスト IP を指定する（コンテナ内の localhost は自分自身）。
# 開発機のローカル DB を使う場合だけ localhost に変更する。
STUDY21_DATASOURCE_URL=jdbc:postgresql://192.168.0.100:54320/study21
STUDY21_DATASOURCE_USERNAME=postgres
STUDY21_DATASOURCE_PASSWORD=change-me

# ---- Redis（セッションの保存先）----
# ログイン状態は Redis に置く（user-api だけが使う）。
# コンテナの中では compose が STUDY21_REDIS_HOST=redis を渡すので、
# ここに書くのはローカルで直接動かすとき用。
STUDY21_REDIS_HOST=192.168.0.100
STUDY21_REDIS_PORT=6379
STUDY21_REDIS_PASSWORD=change-me

# ---- Docker Compose / deployment ----
STUDY21_ALLOWED_ORIGINS=http://localhost:8090,http://localhost:8091
STUDY21_DOCUMENT_STORAGE_HOST_PATH=./data/documents
STUDY2_DOCUMENT_STORAGE_HOST_PATH=./data/legacy-documents
STUDY21_TEMPFILE_STORAGE_HOST_PATH=./data/temp-files
STUDY21_TESTFILE_STORAGE_HOST_PATH=./data/test-files
# 書籍の本文 PDF・表紙（読書管理）。新規アップロードは reading 側に入る
STUDY21_READING_STORAGE_HOST_PATH=./data/reading
# 2.0 の webapps/file/ENGLISH_READING をコピーして置く場所（読み取り専用）
STUDY2_READING_STORAGE_HOST_PATH=./data/legacy-reading
# 学習状況モニターのスナップショット画像（2.0 の snapshots フォルダーの中身＝日付フォルダーを置く）
STUDY21_STUDY_MONITOR_SNAPSHOT_HOST_PATH=./data/snapshots

# ---- Container timezone (all three services) ----
# ログの時刻を日本時間に揃える。nginx イメージは tzdata を Dockerfile で導入済み。
STUDY21_TZ=Asia/Tokyo
