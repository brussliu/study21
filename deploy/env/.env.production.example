# Study 2.1 — production environment template（示例）
# 不含数据库 URL / 用户名 / 密码 / 密钥。

APP_ENV=production

ADMIN_API_PORT=8081
USER_API_PORT=8082

# CORS 允许来源（逗号分隔，禁止 "*"）
ALLOWED_ORIGINS=https://study21.example.com

# 前端构建时指定（可选，默认走同域 /api/admin、/api/user）
VITE_ADMIN_API_BASE_URL=/api/admin
VITE_USER_API_BASE_URL=/api/user
