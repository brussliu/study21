<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.study21</groupId>
        <artifactId>study21-backend</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>admin-api</artifactId>
    <name>admin-api</name>
    <description>Study 2.1 administrator backend service</description>

    <dependencies>
        <dependency>
            <groupId>com.study21</groupId>
            <artifactId>common-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.study21</groupId>
            <artifactId>common-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 統一持久層: MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.4</version>
        </dependency>
        <!-- プロキシサービス（batS01 が起動する。2.0 と同じ LittleProxy 1.1.2） -->
        <dependency>
            <groupId>org.littleshoot</groupId>
            <artifactId>littleproxy</artifactId>
            <version>1.1.2</version>
            <exclusions>
                <!--
                  LittleProxy は SLF4J 1.x 時代の log4j バインディングを持ち込む。
                  そのままだと SLF4J のバインディングが 2 つになり、どの実装が選ばれるかが
                  classpath の並び順まかせになる（logback が選ばれないと
                  app / sql / error のログ出力そのものが壊れる）。
                -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
          AI（LLM）の呼び出しは LangChain4j を使う（AI 画図助手 batC52 から移行）。
          OpenAI 互換の chat/completions を叩くので langchain4j-open-ai だけで足りる
          （qwen / doubao / deepseek / chatgpt はすべて OpenAI 互換の URL が設定済み）。
          HTTP の実体は langchain4j-http-client-jdk（JDK の java.net.http.HttpClient）が
          推移的に入る。バージョンは親 pom の langchain4j-bom が決める。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>
        <!--
          AI の出力データ構造（DTO）と、そこから JSON Schema を自動生成する仕組み。
          - swagger-annotations-jakarta … DTO の全フィールドに付ける @Schema(description=...)
          - victools jsonschema-generator … DTO → JSON Schema（説明・required・enum・入れ子・List）
          生成結果は「プロンプトへの出力形式の注入」と「設定ページの Data TAB」の両方で使う
          （DTO が唯一の定義。プロンプトや DB に JSON Schema を二重管理しない）。
        -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-generator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-module-swagger-2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-module-jackson</artifactId>
        </dependency>
        <!-- PostgreSQL JDBC -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
