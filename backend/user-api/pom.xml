<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.study21</groupId>
        <artifactId>study21-backend</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>user-api</artifactId>
    <name>user-api</name>
    <description>Study 2.1 user backend service (students and guardians)</description>

    <dependencies>
        <dependency>
            <groupId>com.study21</groupId>
            <artifactId>common-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.study21</groupId>
            <artifactId>common-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 統一持久層: MyBatis（admin-api と同じバージョン） -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.4</version>
        </dependency>
        <!-- PostgreSQL JDBC -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- セッションは Redis に置く（複数コンテナ・再起動でもログイン状態が消えない）。
             spring-session-data-redis が HttpSession を Redis 実装に差し替えるので、
             アプリ側のコード（ログイン時の session.setAttribute）はそのままでよい。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- テスト用の Redis（本物の redis-server を一時的に起動する）。
             セッションが本当に Redis に入ることを、実サーバー無しで検証するため。
             本番の依存には入らない（test スコープ）。 -->
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>embedded-redis</artifactId>
            <version>1.4.3</version>
            <scope>test</scope>
        </dependency>

        <!--
            授業録音の**書き起こし音声の常時接続**（ブラウザ→後端）。
            HTTP の 1 往復ごとの送信だと、往復が遅いときに音が貯まって遅れが出るため、
            音源ごとに WebSocket を 1 本つなぎっぱなしにして 100ms ずつ送る
            （フレーム番号と受け取り確認で、断線後の送り直しも安全にする）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
